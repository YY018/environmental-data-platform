# Copy this file to .env and fill in real values. Never commit .env.
# In GitHub Actions these values come from repository secrets instead.

# OpenAQ API key (obtained in Phase 2 from https://explore.openaq.org/register)
OPENAQ_API_KEY=

# Neon PostgreSQL connection string (created in Phase 5).
# Format: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
