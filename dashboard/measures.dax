// Power BI measures for the reporting views. Add each one under New measure.
// Table names match the views in migration 004_reporting_views.sql.

// ---------- Weather ----------

Avg Temperature (°C) =
AVERAGE ( v_weather_daily[avg_temperature_c] )

Total Rainfall (mm) =
SUM ( v_weather_daily[total_precipitation_mm] )

Max Wind (km/h) =
MAX ( v_weather_daily[max_wind_speed_kmh] )

Days With Rain =
CALCULATE (
    COUNTROWS ( v_weather_daily ),
    v_weather_daily[total_precipitation_mm] > 0
)

// ---------- Air quality ----------

Avg PM2.5 (µg/m³) =
AVERAGE ( v_pm25_daily[avg_pm25] )

Days Above WHO Guideline =
// WHO 2021 guideline for 24-hour mean PM2.5 is 15 µg/m³.
CALCULATE (
    COUNTROWS ( v_pm25_daily ),
    v_pm25_daily[avg_pm25] > 15
)

Share Of Days Above Guideline =
DIVIDE ( [Days Above WHO Guideline], COUNTROWS ( v_pm25_daily ) )

Stations Reporting =
DISTINCTCOUNT ( v_air_quality_hourly[sensor_id] )

// ---------- Earthquakes ----------

Event Count =
COUNTROWS ( v_earthquakes )

Strongest Event =
MAX ( v_earthquakes[magnitude] )

Avg Depth (km) =
AVERAGE ( v_earthquakes[depth_km] )

Tsunami Flags =
CALCULATE (
    COUNTROWS ( v_earthquakes ),
    v_earthquakes[tsunami_flag] = TRUE ()
)

// ---------- Pipeline health ----------

// Subtitle and colour helpers (dynamic text and table colouring).


Last Successful Load =
CALCULATE (
    MAX ( v_pipeline_health[finished_at] ),
    v_pipeline_health[status] = "succeeded"
)

Failed or Partial Runs (Last 7 Days) =
CALCULATE (
    COUNTROWS ( v_pipeline_health ),
    v_pipeline_health[status] IN { "failed", "partial" },
    v_pipeline_health[started_at] >= NOW () - 7
)

Rows Rejected (last 7 days) =
CALCULATE (
    SUM ( v_pipeline_health[rows_rejected] ),
    v_pipeline_health[started_at] >= NOW () - 7
)

// ---------- Dynamic titles and subtitles ----------

Weather Subtitle =
"Daily weather from " & FORMAT ( MIN ( v_weather_daily[reading_date] ), "d mmm yyyy" ) & " to " & FORMAT ( MAX ( v_weather_daily[reading_date] ), "d mmm yyyy" )

Air Quality Subtitle =
"Daily PM2.5 from " & FORMAT ( MIN ( v_pm25_daily[reading_date] ), "d mmm yyyy" ) & " to " & FORMAT ( MAX ( v_pm25_daily[reading_date] ), "d mmm yyyy" )

Earthquake Map Title =
IF (
    COUNTROWS ( v_earthquakes ) = 0,
    "Earthquakes: no events in the current selection",
    "Earthquakes, " & FORMAT ( MIN ( v_earthquakes[event_date] ), "d mmm yyyy" ) & " to " & FORMAT ( MAX ( v_earthquakes[event_date] ), "d mmm yyyy" )
)

Earthquakes Subtitle =
"Events of magnitude 2.5 and above, " & FORMAT ( MIN ( v_earthquakes[event_date] ), "d mmm yyyy" ) & " to " & FORMAT ( MAX ( v_earthquakes[event_date] ), "d mmm yyyy" )

Pipeline Health Subtitle =
"Load runs from " & FORMAT ( MIN ( v_pipeline_health[started_at] ), "d mmm yyyy" ) & " to " & FORMAT ( MAX ( v_pipeline_health[started_at] ), "d mmm yyyy" )

// Background colour for the status cell (table conditional formatting).
Status Colour =
SWITCH (
    SELECTEDVALUE ( v_pipeline_health[status] ),
    "failed", "#F4B6B6",
    "partial", "#FFE08A",
    "succeeded", "#B7E4B0",
    "#FFFFFF"
)
