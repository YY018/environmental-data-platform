table v_weather_daily
	lineageTag: b579b354-9060-4db4-8a31-3b7d5c110a80

	measure 'Days With Rain' = ```
			
			CALCULATE (
			    COUNTROWS ( v_weather_daily ),
			    v_weather_daily[total_precipitation_mm] > 0
			)
			
			
			```
