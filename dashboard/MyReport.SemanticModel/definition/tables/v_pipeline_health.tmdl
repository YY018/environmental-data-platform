table v_pipeline_health
	lineageTag: f6890320-f09b-4cb6-a98c-31ab2163167a

	measure 'Last Successful Load' = ```
			
			CALCULATE (
			    MAX ( v_pipeline_health[finished_at] ),
			    v_pipeline_health[status] = "succeeded"
			)
			
			```
		lineageTag: 750a650e-d6c8-437f-b9f8-c78814c3fc4a

	measure 'Rows Rejected (last 7 days)' = ```
			
			CALCULATE (
			    SUM ( v_pipeline_health[rows_rejected] ),
			    v_pipeline_health[started_at] >= NOW () - 7
			)
			
			```
		formatString: 0
		lineageTag: 0017d3a7-0897-431a-a9a5-fe25cef80fcf

